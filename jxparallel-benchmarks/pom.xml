<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.bacuriim</groupId>
        <artifactId>jxparallel-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>jxparallel-benchmarks</artifactId>
    <name>JXParallel Benchmarks</name>
    <description>JMH benchmarks for task scheduling and cache performance.</description>

    <properties>
        <!-- not published to Maven Central (release profile) -->
        <skipPublishing>true</skipPublishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.bacuriim</groupId>
            <artifactId>jxparallel-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bacuriim</groupId>
            <artifactId>jxparallel-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
