<?xml version="1.0" encoding="UTF-8"?>
<!-- The sample screen of jxparallel-android: a label changed by a button, a text field and a switch. -->
<Column controller="com.jxparallel.android.demo.HelloController" gap="16" padding="24" alignment="TOP_LEFT" fillWidth="true">
  <Label text="JXParallel on Android" bold="true" fontSize="22"/>
  <Label text="${greeting}" fontSize="16"/>
  <Button text="Say hello" onAction="#sayHello" variant="filled"/>
  <TextField text="@{name}" prompt="Your name"/>
  <Row gap="12" alignment="CENTER_LEFT">
    <Switch selected="@{notify}"/>
    <Label text="${notifyText}"/>
  </Row>
  <Label text="${taps}"/>
</Column>
