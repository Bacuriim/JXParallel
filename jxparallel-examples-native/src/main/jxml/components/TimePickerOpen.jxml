<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <TimePicker>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TimePickerOpenController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${times}" var="i" type="java.lang.String">
    <TimePicker value="${i}" hour24="true" minuteStep="15" showing="true"/>
  </For>
</Column>
