<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <Spinner>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.SpinnerController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${digits}" var="i" type="java.lang.String">
    <Spinner min="0" max="100" value="${i}"/>
  </For>
</Column>
