<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1000 instances of <ProgressIndicator>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ProgressIndicatorController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${fractions}" var="i" type="java.lang.Double">
    <ProgressIndicator progress="${i}"/>
  </For>
</Column>
