<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 5000 instances of <Slider>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.SliderController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${numbers}" var="i" type="java.lang.Double">
    <Slider min="0" max="100" value="${i}"/>
  </For>
</Column>
