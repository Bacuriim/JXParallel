<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <SizedBox>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.SizedBoxController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${widths}" var="i" type="java.lang.Double">
    <SizedBox width="${i}" height="20"><Label text="x"/></SizedBox>
  </For>
</Column>
