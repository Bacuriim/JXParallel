<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <Border>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.BorderController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Border><Label slot="top" text="${i}"/><Label slot="center" text="b"/><Label slot="bottom" text="c"/></Border>
  </For>
</Column>
