<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <Tabs>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TabsController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Tabs selected="0" prefHeight="60"><Tab title="One" closable="false"><Label text="${i}"/></Tab><Tab title="Two" closable="false"><Label text="b"/></Tab><Tab title="Three" closable="false"><Label text="c"/></Tab></Tabs>
  </For>
</Column>
