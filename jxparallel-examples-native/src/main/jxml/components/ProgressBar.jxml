<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 5000 instances of <ProgressBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ProgressBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${fractions}" var="i" type="java.lang.Double">
    <ProgressBar progress="${i}" prefWidth="200"/>
  </For>
</Column>
