<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 100 instances of <Drawer>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.DrawerController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Drawer side="left" showing="false"><Label text="${i}"/><Button text="b"/></Drawer>
  </For>
</Column>
