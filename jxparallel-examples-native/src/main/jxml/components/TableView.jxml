<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 20 instances of <TableView>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TableViewController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${firsts}" var="i" type="java.lang.Integer">
    <TableView items="${rowsModel}" var="r" type="com.jxparallel.examples.nativeui.components.BenchRow" key="${r}" first="${i}" rows="30" rowHeight="24" columns="Id, Name, Total" columnWidths="60, 160, 80" prefHeight="750"><TableRow><TableCell text="${r.id}"/><TableCell text="${r.name}"/><TableCell text="${r.total}"/></TableRow></TableView>
  </For>
</Column>
