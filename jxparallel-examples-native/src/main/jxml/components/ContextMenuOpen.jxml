<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1000 instances of <ContextMenu>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ContextMenuOpenController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <ContextMenu showing="true"><MenuItem text="${i}"/><MenuItem text="b"/></ContextMenu>
  </For>
</Column>
