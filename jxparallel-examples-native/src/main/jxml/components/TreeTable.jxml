<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 8 instances of <TreeTable>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TreeTableController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${firsts}" var="i" type="java.lang.Integer">
    <TreeTable rowHeight="24" first="${i}" rows="30" columns="Name, Size" columnWidths="-1, 80" constrained="true" prefHeight="750"><For items="${folders}" var="f" type="com.jxparallel.examples.nativeui.components.BenchFolder" key="${f}"><TreeItem text="${f.name}" expanded="true" values="${f.size}"><For items="${f.children}" var="c" type="java.lang.String" key="${c}"><TreeItem text="${c}" values="${f.size}"/></For></TreeItem></For></TreeTable>
  </For>
</Column>
