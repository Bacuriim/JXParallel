<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <BottomAppBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.BottomAppBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <BottomAppBar><Label text="${i}"/><Label text="b"/></BottomAppBar>
  </For>
</Column>
