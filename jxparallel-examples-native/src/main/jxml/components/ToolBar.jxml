<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <ToolBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ToolBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <ToolBar><Button text="${i}"/><Button text="b"/><Button text="c"/></ToolBar>
  </For>
</Column>
