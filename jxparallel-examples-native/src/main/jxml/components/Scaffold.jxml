<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <Scaffold>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ScaffoldController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Scaffold prefHeight="80"><AppBar title="${i}"/><Label text="body"/><BottomAppBar><Label text="s"/></BottomAppBar></Scaffold>
  </For>
</Column>
