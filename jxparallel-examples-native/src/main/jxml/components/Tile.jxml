<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <Tile>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TileController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Tile hgap="4" vgap="4" prefColumns="3" prefTileWidth="60" prefTileHeight="24"><Label text="${i}"/><Label text="b"/><Label text="c"/></Tile>
  </For>
</Column>
