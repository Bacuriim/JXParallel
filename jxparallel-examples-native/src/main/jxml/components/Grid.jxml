<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <Grid>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.GridController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Grid hgap="4" vgap="4"><Label text="${i}" row="0" column="0"/><Label text="b" row="0" column="1"/><Label text="c" row="1" column="0"/></Grid>
  </For>
</Column>
