<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <Pane>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.PaneController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
