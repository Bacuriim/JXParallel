<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <Scroll>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ScrollController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Scroll fitToWidth="true" prefHeight="40"><Label text="${i}"/></Scroll>
  </For>
</Column>
