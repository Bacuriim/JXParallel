<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1000 instances of <MenuButton>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.MenuButtonController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <MenuButton text="${i}"><MenuItem text="a"/><MenuItem text="b"/><MenuItem text="c"/></MenuButton>
  </For>
</Column>
