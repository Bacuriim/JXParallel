<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 100 instances of <AlertDialog>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.AlertDialogController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <AlertDialog title="${i}" message="msg" confirmText="OK" cancelText="Cancel" showing="false"/>
  </For>
</Column>
