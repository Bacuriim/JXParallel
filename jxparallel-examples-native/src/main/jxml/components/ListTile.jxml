<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <ListTile>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ListTileController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <ListTile title="${i}" subtitle="sub"><Label slot="leading" text="L"/><Button slot="trailing" text="T"/></ListTile>
  </For>
</Column>
