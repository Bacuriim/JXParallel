<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <NavigationBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.NavigationBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <NavigationBar><Button text="${i}"/><Button text="b"/><Button text="c"/></NavigationBar>
  </For>
</Column>
