<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <MenuBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.MenuBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <MenuBar><Menu text="${i}"><MenuItem text="a"/><MenuItem text="b"/></Menu><Menu text="Edit"><MenuItem text="c"/><MenuItem text="d"/></Menu></MenuBar>
  </For>
</Column>
