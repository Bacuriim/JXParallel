<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <SplitPane>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.SplitPaneController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <SplitPane orientation="horizontal" dividerPositions="0.3, 0.7" prefHeight="40"><Label text="${i}"/><Label text="b"/><Label text="c"/></SplitPane>
  </For>
</Column>
