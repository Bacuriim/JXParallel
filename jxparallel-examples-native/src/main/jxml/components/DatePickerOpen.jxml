<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <DatePicker>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.DatePickerOpenController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${dates}" var="i" type="java.lang.String">
    <DatePicker value="${i}" showing="true"/>
  </For>
</Column>
