<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <PasswordField>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.PasswordFieldController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <PasswordField text="${i}" prompt="Secret" columns="12"/>
  </For>
</Column>
