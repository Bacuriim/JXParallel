<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <ComboBox>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ComboBoxOpenController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <ComboBox items="${choices}" value="${i}" showing="true"/>
  </For>
</Column>
