<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <Pagination>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.PaginationController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${pages}" var="i" type="java.lang.Integer">
    <Pagination pageCount="10" current="${i}"><Label text="page"/></Pagination>
  </For>
</Column>
