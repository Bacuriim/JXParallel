<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <TextFlow>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TextFlowController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <TextFlow><Label text="${i}"/><Label text="b"/><Hyperlink text="c"/></TextFlow>
  </For>
</Column>
