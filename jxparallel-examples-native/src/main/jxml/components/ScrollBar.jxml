<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <ScrollBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ScrollBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${numbers}" var="i" type="java.lang.Double">
    <ScrollBar min="0" max="100" value="${i}" visibleAmount="10" orientation="horizontal"/>
  </For>
</Column>
