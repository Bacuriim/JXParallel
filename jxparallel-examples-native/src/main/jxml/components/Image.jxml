<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 5000 instances of <Image>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ImageController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${widths}" var="i" type="java.lang.Double">
    <Image pixels="${pixels}" imageWidth="16" imageHeight="16" fitWidth="${i}" fitHeight="32" preserveRatio="false"/>
  </For>
</Column>
