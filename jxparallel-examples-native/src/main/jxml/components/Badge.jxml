<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <Badge>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.BadgeController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${ints}" var="i" type="java.lang.Integer">
    <Badge count="${i}" max="99"><Label text="x"/></Badge>
  </For>
</Column>
