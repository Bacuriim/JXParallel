<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 1500 instances of <ColorPicker>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.ColorPickerController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${colors}" var="i" type="java.lang.String">
    <ColorPicker value="${i}" prompt="#RRGGBB"/>
  </For>
</Column>
