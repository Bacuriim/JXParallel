<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 5000 instances of <Hyperlink>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.HyperlinkController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Hyperlink text="${i}"/>
  </For>
</Column>
