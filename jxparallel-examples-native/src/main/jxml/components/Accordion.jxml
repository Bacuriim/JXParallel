<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 800 instances of <Accordion>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.AccordionController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${items}" var="i" type="java.lang.String">
    <Accordion><TitledPane text="${i}" expanded="true"><Label text="a"/></TitledPane><TitledPane text="b" expanded="false"><Label text="c"/></TitledPane></Accordion>
  </For>
</Column>
