<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 2000 instances of <TabBar>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TabBarController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${steps}" var="i" type="java.lang.Integer">
    <TabBar titles="${titles}" selected="${i}"/>
  </For>
</Column>
