<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/generate-component-bench.py. 8 instances of <Tree>, one bound value each. -->
<Column controller="com.jxparallel.examples.nativeui.components.TreeController" gap="2" padding="4" alignment="TOP_LEFT" fillWidth="true">
  <For items="${firsts}" var="i" type="java.lang.Integer">
    <Tree rowHeight="24" first="${i}" rows="30" prefHeight="720"><For items="${folders}" var="f" type="com.jxparallel.examples.nativeui.components.BenchFolder" key="${f}" memo="true"><TreeItem text="${f.name}" expanded="true"><For items="${f.children}" var="c" type="java.lang.String" key="${c}"><TreeItem text="${c}"/></For></TreeItem></For></Tree>
  </For>
</Column>
