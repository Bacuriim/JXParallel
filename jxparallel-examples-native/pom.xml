<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.bacuriim</groupId>
        <artifactId>jxparallel-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>jxparallel-examples-native</artifactId>
    <name>JXParallel Native Examples</name>
    <description>Skia examples that do not depend on JavaFX.</description>

    <properties>
        <!-- not published to Maven Central (release profile) -->
        <skipPublishing>true</skipPublishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.bacuriim</groupId>
            <artifactId>jxparallel-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bacuriim</groupId>
            <artifactId>jxparallel-forge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the JXML files too, for the interpreter modes of ForgeLoadBenchmark -->
            <resource>
                <directory>src/main/jxml</directory>
            </resource>
        </resources>
        <!-- Maven cannot run a plugin built in the same reactor before it is installed, so the
             default build calls the JXForge command line on the reactor's classes; the profile
             jxforge-plugin uses jxforge-maven-plugin instead (run mvn install once first). -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>views</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>--src</argument>
                                <argument>${project.basedir}/src/main/jxml/forgebench</argument>
                                <argument>--out</argument>
                                <argument>${project.build.directory}/generated-sources/jxforge</argument>
                                <argument>--package</argument>
                                <argument>com.jxparallel.examples.nativeui.forgebench.gen</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- the same screens without constant hoisting, to measure what hoisting adds -->
                    <execution>
                        <id>views-plain</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>--src</argument>
                                <argument>${project.basedir}/src/main/jxml/forgebench</argument>
                                <argument>--out</argument>
                                <argument>${project.build.directory}/generated-sources/jxforge-plain</argument>
                                <argument>--package</argument>
                                <argument>com.jxparallel.examples.nativeui.forgebench.plain</argument>
                                <argument>--no-hoist</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- JX Orders, the sample application (com.jxparallel.examples.orders) -->
                    <execution>
                        <id>views-orders</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>--src</argument>
                                <argument>${project.basedir}/src/main/jxml/orders</argument>
                                <argument>--out</argument>
                                <argument>${project.build.directory}/generated-sources/jxforge-orders</argument>
                                <argument>--package</argument>
                                <argument>com.jxparallel.examples.orders.gen</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- the per-component samples (ComponentBench). Only the hoisted build: what hoisting adds was measured with the 20 screens -->
                    <execution>
                        <id>views-components</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>--src</argument>
                                <argument>${project.basedir}/src/main/jxml/components</argument>
                                <argument>--out</argument>
                                <argument>${project.build.directory}/generated-sources/jxforge-components</argument>
                                <argument>--package</argument>
                                <argument>com.jxparallel.examples.nativeui.components.gen</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.jxparallel.forge.JXForge</mainClass>                    <classpathScope>compile</classpathScope>
                    <blockSystemExit>true</blockSystemExit>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-jxforge-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jxforge</source>
                                <source>${project.build.directory}/generated-sources/jxforge-plain</source>
                                <source>${project.build.directory}/generated-sources/jxforge-components</source>
                                <source>${project.build.directory}/generated-sources/jxforge-orders</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- the sample screens of the forge tests, mounted on the native renderer by ForgeTagsMountTest -->
                    <execution>
                        <id>add-forge-samples</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../jxparallel-forge/src/test/shared/java</source>
                            </sources>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../jxparallel-forge/src/test/shared</directory>
                                    <includes>
                                        <include>samples/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jxforge-plugin</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>views</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>views-plain</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>views-components</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>views-orders</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.github.bacuriim</groupId>
                        <artifactId>jxforge-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>views</id>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <packageName>com.jxparallel.examples.nativeui.forgebench.gen</packageName>
                                    <sourceDirectory>${project.basedir}/src/main/jxml/forgebench</sourceDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>views-plain</id>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <packageName>com.jxparallel.examples.nativeui.forgebench.plain</packageName>
                                    <outputDirectory>${project.build.directory}/generated-sources/jxforge-plain</outputDirectory>
                                    <hoistConstants>false</hoistConstants>
                                    <sourceDirectory>${project.basedir}/src/main/jxml/forgebench</sourceDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>views-components</id>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <packageName>com.jxparallel.examples.nativeui.components.gen</packageName>
                                    <sourceDirectory>${project.basedir}/src/main/jxml/components</sourceDirectory>
                                    <outputDirectory>${project.build.directory}/generated-sources/jxforge-components</outputDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>views-orders</id>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <packageName>com.jxparallel.examples.orders.gen</packageName>
                                    <sourceDirectory>${project.basedir}/src/main/jxml/orders</sourceDirectory>
                                    <outputDirectory>${project.build.directory}/generated-sources/jxforge-orders</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Runs an example from the reactor, in its own JVM:
               mvn -pl jxparallel-examples-native -am -Prun -Dapp=orders -DskipTests
             -Dapp: orders (default), hello, metrics, stress, components, forge-load.
             -Dapp.args gives the program's arguments (see docs/example-orders.md)
             and -Dapp.jvm="-Djx.renderer=software" the JVM's options. The profile exists only in this module,
             so -am builds the others without running anything. -->
        <profile>
            <id>run</id>
            <properties>
                <app>orders</app>
                <app.args></app.args>
                <app.jvm></app.jvm>
                <app.main>com.jxparallel.examples.orders.OrdersApp</app.main>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-app</id>
                                <!-- after the default compile of this module -->
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <classpathScope>runtime</classpathScope>
                                    <commandlineArgs>${app.jvm} -cp %classpath ${app.main} ${app.args}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>app-hello</id>
            <activation><property><name>app</name><value>hello</value></property></activation>
            <properties><app.main>com.jxparallel.examples.nativeui.NativeHelloApp</app.main></properties>
        </profile>
        <profile>
            <id>app-metrics</id>
            <activation><property><name>app</name><value>metrics</value></property></activation>
            <properties><app.main>com.jxparallel.examples.nativeui.NativeMetricsRunner</app.main></properties>
        </profile>
        <profile>
            <id>app-stress</id>
            <activation><property><name>app</name><value>stress</value></property></activation>
            <properties><app.main>com.jxparallel.examples.nativeui.NativeStressRunner</app.main></properties>
        </profile>
        <profile>
            <id>app-components</id>
            <activation><property><name>app</name><value>components</value></property></activation>
            <properties><app.main>com.jxparallel.examples.nativeui.ComponentBench</app.main></properties>
        </profile>
        <profile>
            <id>app-forge-load</id>
            <activation><property><name>app</name><value>forge-load</value></property></activation>
            <properties><app.main>com.jxparallel.examples.nativeui.ForgeLoadBenchmark</app.main></properties>
        </profile>
    </profiles>
</project>
