<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jxparallel.fx.fxml.OuterController" maxHeight="-Infinity">
   <children>
      <Label fx:id="title" text="Title" />
      <GridPane>
         <columnConstraints><ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" /></columnConstraints>
         <children>
            <Spinner fx:id="spinner" min="0" max="10" initialValue="3" GridPane.columnIndex="0" />
         </children>
         <VBox.margin><Insets top="4.0" /></VBox.margin>
      </GridPane>
      <fx:include fx:id="inner" source="Inner.fxml" />
   </children>
</VBox>
