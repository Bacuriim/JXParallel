<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.bacuriim</groupId>
    <artifactId>jxparallel-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>JXParallel Parent</name>
    <description>Parent POM for the JXParallel multi-module library.</description>
    <url>https://github.com/Bacuriim/JXParallel</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>bacuriim</id>
            <name>Conrado Einstein Malessa de Oliveira</name>
            <url>https://github.com/Bacuriim</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/Bacuriim/JXParallel.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Bacuriim/JXParallel.git</developerConnection>
        <url>https://github.com/Bacuriim/JXParallel</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>jxparallel-core</module>
        <module>jxparallel-ui</module>
        <module>jxparallel-examples-native</module>
        <module>jxparallel-junit4</module>
        <module>jxparallel-junit5</module>
        <module>jxparallel-mockito</module>
        <module>jxparallel-powermock</module>
        <module>jxparallel-benchmarks</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <javafx.version>21.0.2</javafx.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <junit.version>4.13.2</junit.version>
        <mockito.version>5.12.0</mockito.version>
        <powermock.version>2.0.9</powermock.version>
        <jmh.version>1.37</jmh.version>
        <jqwik.version>1.8.5</jqwik.version>
        <archunit.version>1.3.0</archunit.version>
        <skija.version>0.116.4</skija.version>
        <lwjgl.version>3.3.3</lwjgl.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Line/branch coverage: mvn -Pcoverage test, report in <module>/target/site/jacoco -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Mutation testing: mvn -Pmutation -pl jxparallel-core,jxparallel-ui -am test-compile
             org.pitest:pitest-maven:mutationCoverage, report in <module>/target/pit-reports -->
        <profile>
            <id>mutation</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-maven</artifactId>
                            <version>1.15.8</version>
                            <dependencies>
                                <dependency>
                                    <groupId>org.pitest</groupId>
                                    <artifactId>pitest-junit5-plugin</artifactId>
                                    <version>1.2.1</version>
                                </dependency>
                            </dependencies>
                            <configuration>
                                <targetClasses>
                                    <param>com.jxparallel.*</param>
                                </targetClasses>
                                <timestampedReports>false</timestampedReports>
                                <outputFormats>
                                    <param>HTML</param>
                                    <param>CSV</param>
                                </outputFormats>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
        <!-- Maven Central (central.sonatype.com, namespace io.github.bacuriim). Two deployments, because the modules
             need two JDKs (see RELEASING.md): on JDK 8 the library and the JavaFX-compatible API, on JDK 17 with
             -Plegacy-javafx the modules built on OpenJFX. The deployment is uploaded and validated, not published:
             it is published from the Central Portal. Modules that are not published set skipPublishing. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- OpenJDK jcstress concurrency tests: mvn -Pjcstress -pl jxparallel-jcstress -am package,
             then java -jar jxparallel-jcstress/target/jcstress.jar -->
        <profile>
            <id>jcstress</id>
            <modules>
                <module>jxparallel-jcstress</module>
            </modules>
        </profile>
        <!-- On JDK 9+, source/target 1.8 still links against the newer JDK API
             (e.g. ByteBuffer.flip() returning ByteBuffer) and fails on Java 8 at runtime. -->
        <profile>
            <id>release-8</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>
        <!-- Mockito 5 needs Java 11; on JDK 8 the Mockito and PowerMock modules use the last 4.x. -->
        <profile>
            <id>mockito-java8</id>
            <activation>
                <jdk>1.8</jdk>
            </activation>
            <properties>
                <mockito.version>4.11.0</mockito.version>
            </properties>
        </profile>
        <!-- JDKs 8 that bundle JavaFX (Oracle, Zulu FX) build the JavaFX-compatible API too. -->
        <profile>
            <id>javafx8</id>
            <activation>
                <file>
                    <exists>${java.home}/lib/ext/jfxrt.jar</exists>
                </file>
            </activation>
            <modules>
                <module>jxparallel-fx</module>
                <module>jxparallel-fx-controlsfx</module>
            </modules>
        </profile>
        <profile>
            <id>legacy-javafx</id>
            <modules>
                <module>jxparallel-javafx</module>
                <module>jxparallel-fxml</module>
                <module>jxparallel-examples</module>
                <module>jxparallel-fx</module>
            </modules>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-controls</artifactId>
                        <version>${javafx.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-fxml</artifactId>
                        <version>${javafx.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-graphics</artifactId>
                        <version>${javafx.version}</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>
</project>
