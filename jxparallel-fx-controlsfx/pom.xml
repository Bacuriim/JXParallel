<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jxparallel</groupId>
        <artifactId>jxparallel-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jxparallel-fx-controlsfx</artifactId>
    <name>JXParallel FX API for ControlsFX</name>
    <description>com.jxparallel.fx.controlsfx counterparts of the ControlsFX 8 classes applications use,
        for JavaFX 8 applications that migrate to jxparallel-fx.</description>

    <dependencies>
        <dependency>
            <groupId>com.jxparallel</groupId>
            <artifactId>jxparallel-fx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>8.40.14</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- native mode tests, headless, in their own JVM (see jxparallel-fx) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <jx.backend>native</jx.backend>
                        <jx.headless>true</jx.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
