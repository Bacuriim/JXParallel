# JXParallel default configuration
threads.min=2
threads.max=8
threads.auto-scale=true
queue.capacity=500
queue.policy=BLOCK
fxml.cache.enabled=true
fxml.cache.max-size=100
fxml.cache.ttl=30m
fxml.cache.strategy=LRU
fxml.preload.enabled=true
metrics.enabled=false
debug=false
testing.parallel=true
testing.max-threads=8
